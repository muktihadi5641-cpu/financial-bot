# Salin file ini menjadi .env dan isi nilainya

# Token dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Telegram User ID kamu (cari via @userinfobot)
ALLOWED_USER_ID=123456789

# String acak untuk keamanan API sync (buat sendiri, minimal 20 karakter)
SYNC_SECRET=buat_string_acak_panjang_disini_minimal20char

# URL Railway setelah deploy (diisi setelah deploy)
RAILWAY_URL=https://nama-project-kamu.up.railway.app

# Path Excel di PC lokal (untuk sync_to_excel.py)
EXCEL_PATH=C:\Claude\Project\Financial\Financial Management.xlsx

# Path database SQLite di cloud (Railway — jangan diubah)
DB_PATH=transactions.db
